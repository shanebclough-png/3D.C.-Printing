<!DOCTYPE html>
<html lang="en" class="scroll-smooth" >
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>D.C. Custom Prints & Molds</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.3.2/dist/tailwind.min.css" rel="stylesheet" />
  <style>
    /* Enable dark mode throughout */
    html {
      color-scheme: dark;
    }
  </style>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

  <!-- Header / Hero -->
  <header class="flex flex-col items-center justify-center text-center px-6 py-20 border-b border-gray-700">
    <h1 class="text-5xl font-extrabold mb-4">D.C. Custom Prints & Molds</h1>
    <p class="text-lg max-w-xl mb-8">
      Durable FDM prints with fast, local turnaround in Washington D.C.
    </p>
    <a href="#featured-products" class="inline-block bg-cyan-600 hover:bg-cyan-700 text-white font-semibold px-6 py-3 rounded-md transition">
      View Catalog
    </a>
  </header>

  <!-- Featured Products Grid -->
  <section id="featured-products" class="px-6 py-16 max-w-6xl mx-auto w-full">
    <h2 class="text-3xl font-semibold mb-12 text-center">Featured Products</h2>
    <div class="grid gap-10 sm:grid-cols-2">
      
      <!-- Custom Candle/Soap Molds -->
      <div class="bg-gray-800 p-6 rounded-lg shadow-lg flex flex-col justify-between">
        <div>
          <div class="w-full h-48 bg-gray-700 rounded-md mb-4 flex items-center justify-center text-gray-500 text-xl select-none">
            Image Placeholder
          </div>
          <h3 class="text-xl font-semibold mb-2">Custom Candle/Soap Molds</h3>
          <p class="text-gray-400 mb-6">
            Precision molds tailored to your unique design for candles and soaps.
          </p>
        </div>
        <button class="bg-cyan-600 hover:bg-cyan-700 text-white font-semibold py-2 rounded-md transition">
          Buy Now
        </button>
      </div>

      <!-- Articulated Spinosaurus Models -->
      <div class="bg-gray-800 p-6 rounded-lg shadow-lg flex flex-col justify-between">
        <div>
          <div class="w-full h-48 bg-gray-700 rounded-md mb-4 flex items-center justify-center text-gray-500 text-xl select-none">
            Image Placeholder
          </div>
          <h3 class="text-xl font-semibold mb-2">Articulated Spinosaurus Models</h3>
          <p class="text-gray-400 mb-6">
            Highly detailed, movable Spinosaurus replicas, perfect for collectors.
          </p>
        </div>
        <button class="bg-cyan-600 hover:bg-cyan-700 text-white font-semibold py-2 rounded-md transition">
          Buy Now
        </button>
      </div>
    </div>
  </section>

  <!-- Local D.C. Markets -->
  <section class="bg-gray-800 py-12 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-semibold mb-4">Local D.C. Markets</h2>
      <p class="text-gray-400 text-lg">
        Convenient local pickup available near <strong>Georgetown</strong> and <strong>Eastern Market</strong>. Support local and get your prints fast!
      </p>
    </div>
  </section>

  <!-- Custom Orders Form -->
  <section class="py-16 px-6 max-w-4xl mx-auto w-full">
    <h2 class="text-3xl font-semibold mb-8 text-center">Request Custom Design Work</h2>
    <form action="https://formspree.io/f/mayvlrle" method="POST" class="bg-gray-800 p-8 rounded-lg shadow-lg max-w-lg mx-auto space-y-6" >
      <label class="block">
        <span class="text-gray-300">Name</span>
        <input
          type="text"
          name="name"
          required
          class="mt-1 block w-full rounded-md bg-gray-700 border border-gray-600 text-gray-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-cyan-500"
          placeholder="Your full name"
        />
      </label>
      <label class="block">
        <span class="text-gray-300">Email</span>
        <input
          type="email"
          name="_replyto"
          required
          class="mt-1 block w-full rounded-md bg-gray-700 border border-gray-600 text-gray-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-cyan-500"
          placeholder="your.email@example.com"
        />
      </label>
      <label class="block">
        <span class="text-gray-300">Project Details (Tripo 3.1 / Blender design work)</span>
        <textarea
          name="message"
          rows="4"
          required
          class="mt-1 block w-full rounded-md bg-gray-700 border border-gray-600 text-gray-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-cyan-500"
          placeholder="Describe your custom order requirements"
        ></textarea>
      </label>
      <button
        type="submit"
        class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-semibold py-3 rounded-md transition"
      >
        Submit Request
      </button>
    </form>
  </section>

  <footer class="py-6 text-center text-gray-600 text-sm border-t border-gray-700">
    &copy; 2026 D.C. Custom Prints & Molds
  </footer>

</body>
</html>
